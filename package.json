{
  "name": "familyshield",
  "private": true,
  "version": "0.1.0",
  "description": "FamilyShield: an embeddable family-lending module for existing banking apps.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/service",
    "packages/server",
    "packages/sdk",
    "apps/demo-bank"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:browser": "npm run dev -w @familyshield/demo-bank",
    "dev:server": "npm run dev -w @familyshield/server",
    "data:reset": "node scripts/data.mjs reset",
    "data:save": "node scripts/data.mjs save",
    "data:status": "node scripts/data.mjs status",
    "test": "npm run test -w @familyshield/core -w @familyshield/service",
    "test:automation": "node --test .github/scripts/tickets.test.cjs .github/scripts/wiki-ai.test.cjs",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build -w @familyshield/sdk && npm run build -w @familyshield/demo-bank",
    "check": "npm run typecheck && npm test && npm run test:automation && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
