{
  "name": "@familyshield/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "The embeddable FamilyShield module: mount it inside a banking app, or load it in a WebView.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mockup": "./src/mockup/index.ts",
    "./embed": "./src/embed.tsx"
  },
  "scripts": {
    "build": "vite build && vite build --mode lib",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@familyshield/core": "0.1.0",
    "@familyshield/service": "0.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
